# Dedicated Supabase project for the MifiTech portfolio CMS
SUPABASE_URL=https://YOUR_PORTFOLIO_PROJECT.supabase.co
# Use a server-only secret key. Never add NEXT_PUBLIC_ to this value.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# Legacy alternative, if your project still uses the JWT service_role key:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
NEXT_PUBLIC_SITE_URL=https://mifitech-portfolio.vercel.app
