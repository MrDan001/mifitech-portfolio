# Google Places API (New), with Places API enabled and billing configured.
# Used by the admin-only HUNT business discovery tool.
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY
# Optional: Google Programmable Search Engine to find public email references.
GOOGLE_CSE_API_KEY=YOUR_GOOGLE_CUSTOM_SEARCH_API_KEY
GOOGLE_CSE_CX=YOUR_PROGRAMMABLE_SEARCH_ENGINE_ID

# Dedicated Supabase project for the MifiTech portfolio CMS
SUPABASE_URL=https://YOUR_PORTFOLIO_PROJECT.supabase.co
# Use a server-only secret key. Never add NEXT_PUBLIC_ to this value.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# Legacy alternative, if your project still uses the JWT service_role key:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

ADMIN_PASSWORD=Dani1429
